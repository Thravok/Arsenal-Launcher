/* Arsenal Launcher shared stylesheet — placeholders substituted by ThemeTokens::substitute */
/* Glass surfaces use @nameRgba@ so alpha survives substitution. */

QToolTip {
    color: @toolTipText@;
    background-color: @toolTipBaseRgba@;
    border: 1px solid @glassBorderRgba@;
    border-radius: @radius@px;
    padding: 6px 10px;
}

QMainWindow, QDialog {
    background-color: @windowRgba@;
    color: @windowText@;
}

QMenuBar {
    background-color: @glassElevatedRgba@;
    color: @windowText@;
    border-bottom: 1px solid @glassBorderRgba@;
    padding: 2px;
    spacing: 2px;
}
QMenuBar::item {
    background: transparent;
    padding: 6px 10px;
    border-radius: 6px;
}
QMenuBar::item:selected {
    background-color: @alternateBaseRgba@;
    border: 1px solid @glassBorderRgba@;
}
QMenuBar::item:pressed {
    background-color: @highlight@;
    color: @highlightedText@;
}

QMenu {
    background-color: @glassElevatedRgba@;
    color: @windowText@;
    border: 1px solid @border@;
    border-radius: @radius@px;
    padding: 4px;
    menu-scrollable: 1;
}
QMenu::item {
    padding: 6px 24px 6px 12px;
    border-radius: 6px;
}
QMenu::item:selected {
    background-color: @highlight@;
    color: @highlightedText@;
}
QMenu::separator {
    height: 1px;
    background: @glassBorderRgba@;
    margin: 4px 8px;
}

QToolBar {
    background-color: @glassElevatedRgba@;
    border: none;
    border-bottom: 1px solid @glassBorderRgba@;
    spacing: 6px;
    padding: 6px 10px;
}
QFrame#instanceChromeBar {
    background-color: @glassElevatedRgba@;
    border: 1px solid @border@;
    border-radius: @radius@px;
    padding: 4px 8px;
    min-height: 44px;
    margin: 0 0 10px 0;
}
QFrame#instanceChromeSeparator {
    background: @border@;
    max-width: 1px;
    min-width: 1px;
    margin: 6px 10px;
}
QFrame#instanceChromeBar QToolButton#accountMenuButton {
    background-color: @glassFillRgba@;
    border: 1px solid @border@;
    border-radius: @radius@px;
    padding: 6px 16px 6px 10px;
    min-height: @controlHeight@px;
    font-weight: 600;
}
QFrame#instanceChromeBar QToolButton#accountMenuButton:hover {
    background-color: @alternateBaseRgba@;
    border-color: @glassHighlightRgba@;
}
QFrame#instanceChromeBar QToolButton#accountMenuButton:pressed {
    background-color: @glassFillRgba@;
}

QFrame#instanceChromeBar QToolButton {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: @radius@px;
    padding: 6px 12px;
    min-height: @controlHeight@px;
    font-weight: 500;
}
QFrame#instanceChromeBar QToolButton:hover {
    background-color: @alternateBaseRgba@;
    border-color: @border@;
}
QFrame#instanceChromeBar QToolButton:pressed {
    background-color: @alternateBaseRgba@;
}
QToolButton#mainToolbarFoldersButton {
    padding: 6px 12px;
}
QToolBar::separator {
    background: @glassBorderRgba@;
    width: 1px;
    margin: 4px 6px;
}

QFrame#instanceGridFrame {
    background-color: @glassWellRgba@;
    border: 1px solid @border@;
    border-radius: @radius@px;
    padding: 10px 12px 12px 12px;
    margin: 10px 8px 10px 10px;
}

QFrame#instanceActionPanel {
    background-color: @glassElevatedRgba@;
    border: 1px solid @border@;
    padding: 2px 0;
    margin: 10px 12px 10px 6px;
    border-radius: @radius@px;
}

QFrame#instancePanelHero {
    background-color: @glassFillRgba@;
    border: 1px solid @border@;
    border-radius: @radius@px;
}

QToolButton#instancePanelIconButton {
    background: transparent;
    border: none;
    padding: 4px;
}
QToolButton#instancePanelIconButton:hover {
    background-color: @alternateBaseRgba@;
    border-radius: 10px;
}

QLabel#chromeBrandLabel {
    color: @windowText@;
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 0.2px;
}

QFrame#chromeBrand {
    background: transparent;
    border: none;
}

QLabel#instancePanelHomeTitle {
    color: @windowText@;
    font-size: 16px;
    font-weight: 700;
}

QLabel#instancePanelHomeSubtitle {
    color: @mutedText@;
    font-size: 12px;
    padding: 0 4px;
}

QLabel#instancePanelHomeNameProtect {
    color: @mutedText@;
    font-size: 11px;
    padding: 4px 2px;
}

QPushButton#instancePanelHomeAddButton {
    background-color: @accent@;
    color: @accentText@;
    border: 1px solid @accent@;
    border-radius: @radius@px;
    padding: 12px 14px;
    font-weight: 600;
    min-height: 40px;
}
QPushButton#instancePanelHomeAddButton:hover {
    background-color: @highlight@;
    border-color: @highlight@;
}

QPushButton#instancePanelRecentButton {
    text-align: left;
    padding: 10px 12px;
    border: 1px solid @border@;
    border-radius: @radius@px;
    color: @windowText@;
    background-color: @glassFillRgba@;
}
QPushButton#instancePanelRecentButton:hover {
    background-color: @alternateBaseRgba@;
    border-color: @glassHighlightRgba@;
}

QLabel#instanceStatusChip {
    color: @windowText@;
    background-color: @glassFillRgba@;
    border: 1px solid @border@;
    border-radius: 6px;
    padding: 4px 10px;
    font-size: 11px;
    font-weight: 600;
}
QLabel#instanceStatusChip[tone="success"] {
    color: @success@;
    border-color: rgba(47, 191, 113, 80);
    background-color: rgba(47, 191, 113, 24);
}
QLabel#instanceStatusChip[tone="danger"] {
    color: @danger@;
    border-color: rgba(224, 90, 90, 80);
    background-color: rgba(224, 90, 90, 24);
}
QLabel#instanceStatusChip[tone="warning"] {
    color: #e0b14a;
    border-color: rgba(224, 177, 74, 80);
    background-color: rgba(224, 177, 74, 24);
}

/* Shared footer secondary chrome: same height, radius, and surface. */
QToolButton#instancePanelEditButton,
QToolButton#instancePanelMoreButton {
    background-color: @glassFillRgba@;
    border: 1px solid @border@;
    border-radius: @radius@px;
    min-height: 40px;
    max-height: 40px;
    padding: 0 12px;
    font-weight: 600;
    font-size: 13px;
}
QToolButton#instancePanelEditButton {
    padding: 0;
}
QToolButton#instancePanelEditButton:hover,
QToolButton#instancePanelMoreButton:hover {
    background-color: @alternateBaseRgba@;
    border-color: @glassHighlightRgba@;
}
QToolButton#instancePanelEditButton:disabled,
QToolButton#instancePanelMoreButton:disabled {
    color: @mutedText@;
    background-color: @glassFillRgba@;
    border-color: @glassBorderRgba@;
}

QToolButton#instancePanelMoreButton {
    color: @windowText@;
    min-width: 56px;
}
QToolButton#instancePanelMoreButton::menu-indicator {
    image: none;
    width: 0;
    height: 0;
}

QPushButton#instancePanelName {
    color: @windowText@;
    font-size: 18px;
    font-weight: 700;
    text-align: left;
    padding: 2px 2px;
    background: transparent;
    border: none;
}

/* Launch and Kill swap the same primary slot. */
QToolButton#launchPrimaryButton,
QPushButton#instancePanelKillButton {
    border-radius: @radius@px;
    padding: 0 14px;
    font-weight: 600;
    font-size: 13px;
    min-height: 40px;
    max-height: 40px;
}
QToolButton#launchPrimaryButton {
    background-color: @success@;
    color: #ffffff;
    border: 1px solid @success@;
}
QToolButton#launchPrimaryButton:hover {
    background-color: @successHover@;
    border-color: @successHover@;
    color: #ffffff;
}
QToolButton#launchPrimaryButton:disabled {
    background-color: @alternateBaseRgba@;
    color: @mutedText@;
    border-color: @glassBorderRgba@;
}
QToolButton#launchPrimaryButton::menu-button {
    background-color: @success@;
    border: none;
    border-left: 1px solid rgba(255, 255, 255, 0.35);
    border-top-right-radius: @radius@px;
    border-bottom-right-radius: @radius@px;
    width: 28px;
    padding: 0;
}
QToolButton#launchPrimaryButton::menu-button:hover {
    background-color: @successHover@;
}
QToolButton#launchPrimaryButton::menu-button:disabled {
    background-color: @alternateBaseRgba@;
    border-left-color: @glassBorderRgba@;
}
QToolButton#launchPrimaryButton::menu-indicator {
    image: none;
    width: 0;
    height: 0;
}

QPushButton#instancePanelKillButton {
    background-color: @danger@;
    color: #ffffff;
    border: 1px solid @danger@;
}
QPushButton#instancePanelKillButton:hover {
    background-color: @dangerHover@;
    border-color: @dangerHover@;
    color: #ffffff;
}
QPushButton#instancePanelKillButton:disabled {
    background-color: @alternateBaseRgba@;
    color: @mutedText@;
    border-color: @glassBorderRgba@;
}

QFrame#instanceAccountPicker {
    background-color: @glassFillRgba@;
    border: 1px solid @border@;
    border-radius: @radius@px;
    min-height: 48px;
}
QFrame#instanceAccountPicker:hover {
    background-color: @alternateBaseRgba@;
    border-color: @glassHighlightRgba@;
}
QFrame#instanceAccountPicker[launchBlocked="true"] {
    border-color: @danger@;
    background-color: @glassElevatedRgba@;
}
QFrame#instanceAccountPicker:disabled {
    color: @mutedText@;
    background-color: @windowRgba@;
}

QLabel#instanceAccountFace {
    background-color: transparent;
}

QLabel#instanceAccountTitle {
    font-weight: 600;
    color: @windowText@;
}

QLabel#instanceAccountMeta {
    color: @mutedText@;
    font-size: 11px;
}
QLabel#instanceAccountMeta[launchBlocked="true"] {
    color: @danger@;
    font-weight: 600;
}

QToolButton#instanceAccountMenuButton {
    border: none;
    padding: 4px;
    background: transparent;
}
QToolButton#instanceAccountMenuButton:hover {
    background-color: @glassElevatedRgba@;
    border-radius: 6px;
}
QToolButton#instanceAccountMenuButton:disabled {
    color: @mutedText@;
}

QLabel#instanceAccountHeading {
    color: @mutedText@;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    padding: 0 2px;
}

QLabel#instanceAccountCaption {
    color: @mutedText@;
    font-size: 11px;
    padding: 0 4px 4px 4px;
}
QLabel#instanceAccountCaption[launchBlocked="true"] {
    color: @danger@;
}

QPushButton#instancePanelLinkButton {
    text-align: left;
    padding: 10px 12px;
    border: 1px solid transparent;
    border-radius: @radius@px;
    color: @windowText@;
    background: transparent;
}
QPushButton#instancePanelLinkButton:hover {
    background-color: @alternateBaseRgba@;
    border-color: @glassBorderRgba@;
}
QPushButton#instancePanelLinkButton:disabled {
    color: @mutedText@;
}

QScrollArea#instancePanelActionsScroll {
    background: transparent;
    border: none;
}
QWidget#instancePanelActions {
    background: transparent;
}

QToolButton#accountMenuButton {
    background-color: @glassElevatedRgba@;
    border: 1px solid @glassBorderRgba@;
    border-radius: @radius@px;
    padding: 6px 16px 6px 10px;
    min-height: @controlHeight@px;
    font-weight: 600;
}
QToolButton#accountMenuButton:hover {
    background-color: @alternateBaseRgba@;
    border-color: @glassHighlightRgba@;
}
QToolButton#accountMenuButton:pressed {
    background-color: @glassFillRgba@;
}
QToolButton#accountMenuButton::menu-indicator {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 12px;
    height: 12px;
    right: 8px;
}

/* Instance toolbar account picker */
QToolButton#instancePanelIconButton {
    padding: 8px;
    border-radius: @radius@px;
    background-color: @glassFillRgba@;
    border: 1px solid @glassBorderRgba@;
}
QToolButton#instancePanelIconButton:hover {
    border-color: @glassHighlightRgba@;
    background-color: @alternateBaseRgba@;
}
QToolButton {
    background-color: transparent;
    color: @windowText@;
    border: 1px solid transparent;
    border-radius: 8px;
    padding: 6px 10px;
    margin: 1px;
}
QToolButton:hover {
    background-color: @alternateBaseRgba@;
    border-color: @glassBorderRgba@;
}
QToolButton:pressed, QToolButton:checked {
    background-color: @highlight@;
    color: @highlightedText@;
    border-color: @highlight@;
}

QFrame#instanceChromeBar QToolButton#hideNamesButton {
    background-color: @glassElevatedRgba@;
    color: @windowText@;
    border: 1px solid @glassBorderRgba@;
    border-radius: @radius@px;
    padding: 6px 12px;
    min-height: @controlHeight@px;
    font-weight: 600;
}
QFrame#instanceChromeBar QToolButton#hideNamesButton:hover {
    background-color: @alternateBaseRgba@;
    border-color: @glassHighlightRgba@;
}
QFrame#instanceChromeBar QToolButton#hideNamesButton:checked {
    background-color: @success@;
    color: #ffffff;
    border-color: @success@;
}
QFrame#instanceChromeBar QToolButton#hideNamesButton:checked:hover {
    background-color: @successHover@;
    border-color: @successHover@;
    color: #ffffff;
}

QStatusBar {
    background-color: @glassElevatedRgba@;
    color: @mutedText@;
    border-top: 1px solid @glassBorderRgba@;
}
QStatusBar::item {
    border: none;
}

QPushButton {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                      stop:0 @glassHighlightRgba@,
                                      stop:0.12 @buttonRgba@,
                                      stop:1 @buttonRgba@);
    color: @buttonText@;
    border: 1px solid @border@;
    border-radius: @radius@px;
    padding: 8px 16px;
    min-height: @controlHeight@px;
}
QPushButton:hover {
    background-color: @alternateBaseRgba@;
    border-color: @glassHighlightRgba@;
}
QPushButton:pressed {
    background-color: @highlight@;
    color: @highlightedText@;
    border-color: @highlight@;
}
QPushButton:disabled {
    color: @mutedText@;
    background-color: @windowRgba@;
}
QPushButton:default, QPushButton[primary="true"] {
    background-color: @accent@;
    color: @accentText@;
    border-color: @accent@;
    font-weight: 600;
}
QPushButton:default:hover, QPushButton[primary="true"]:hover {
    background-color: @highlight@;
}
QPushButton#searchButton[filterActive="true"] {
    text-decoration: underline;
    color: @accent@;
    font-weight: 600;
}

QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QDoubleSpinBox, QComboBox {
    background-color: @glassFillRgba@;
    color: @text@;
    border: 1px solid @border@;
    border-radius: @radius@px;
    padding: 8px 12px;
    min-height: 32px;
    selection-background-color: @highlight@;
    selection-color: @highlightedText@;
}
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus,
QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus {
    border-color: @accent@;
}
QLineEdit:disabled, QComboBox:disabled, QSpinBox:disabled {
    color: @mutedText@;
    background-color: @windowRgba@;
}

QComboBox::drop-down {
    border: none;
    width: 24px;
}
QComboBox QAbstractItemView {
    background-color: @glassElevatedRgba@;
    color: @text@;
    border: 1px solid @glassBorderRgba@;
    selection-background-color: @highlight@;
    selection-color: @highlightedText@;
    outline: 0;
}

QCheckBox, QRadioButton {
    spacing: 8px;
    color: @windowText@;
}
QCheckBox::indicator, QRadioButton::indicator {
    width: 16px;
    height: 16px;
}

QGroupBox {
    background-color: @glassElevatedRgba@;
    border: 1px solid @border@;
    border-radius: @radius@px;
    margin-top: 12px;
    padding: 12px 10px 10px 10px;
    font-weight: 600;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 6px;
    color: @windowText@;
}

QTabWidget::pane {
    border: 1px solid @border@;
    border-radius: @radius@px;
    background-color: @glassElevatedRgba@;
    top: -1px;
}
QTabBar::tab {
    background-color: @glassFillRgba@;
    color: @mutedText@;
    border: 1px solid @glassBorderRgba@;
    border-bottom: none;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    padding: 8px 14px;
    margin-right: 2px;
}
QTabBar::tab:selected {
    background-color: @glassElevatedRgba@;
    color: @windowText@;
    font-weight: 600;
}
QTabBar::tab:hover:!selected {
    color: @windowText@;
    background-color: @alternateBaseRgba@;
}

QListView, QTreeView, QTableView {
    background-color: @glassFillRgba@;
    alternate-background-color: @alternateBaseRgba@;
    color: @text@;
    border: 1px solid @border@;
    border-radius: @radius@px;
    outline: 0;
    selection-background-color: @highlight@;
    selection-color: @highlightedText@;
}
QListView::item, QTreeView::item {
    padding: 6px 8px;
    border-radius: 8px;
}
QListView::item:hover, QTreeView::item:hover {
    background-color: @alternateBaseRgba@;
}
QListView::item:selected, QTreeView::item:selected {
    background-color: @highlight@;
    color: @highlightedText@;
}

/* Settings / instance / New Instance page chrome */
QFrame#pageSidebar {
    background-color: @glassElevatedRgba@;
    border: none;
    border-right: 1px solid @border@;
}
QFrame#pageHeaderBar {
    background-color: @glassElevatedRgba@;
    border: none;
    border-bottom: 1px solid @border@;
}
QFrame#pageContentWell {
    background-color: @glassWellRgba@;
    border: none;
}
QLineEdit#pageFilter {
    background-color: @glassFillRgba@;
    border: 1px solid @glassBorderRgba@;
    border-radius: 10px;
    padding: 6px 10px;
    min-height: 32px;
}

/* Settings / instance page sidebar */
QListView#pageList,
QTreeView#pageList {
    background-color: transparent;
    border: none;
    border-radius: 0;
    padding: 4px 2px;
    outline: 0;
}
QListView#pageList::item,
QTreeView#pageList::item {
    padding: 8px 12px;
    margin: 2px 4px;
    border-radius: 8px;
    min-height: @sidebarRowHeight@px;
}
QListView#pageList::item:selected,
QTreeView#pageList::item:selected {
    background-color: @highlight@;
    color: @highlightedText@;
}
QListView#pageList::item:hover:!selected,
QTreeView#pageList::item:hover:!selected {
    background-color: @alternateBaseRgba@;
}
QTreeView#pageList::branch {
    background: transparent;
}
QTreeView#pageList::branch:has-children:closed,
QTreeView#pageList::branch:has-children:open {
    border-image: none;
    image: none;
}

QToolButton#morePlatformsButton {
    background-color: transparent;
    color: @mutedText@;
    border: none;
    border-radius: 8px;
    padding: 8px 12px;
    margin: 2px 4px 8px 4px;
    min-height: 32px;
    text-align: left;
}
QToolButton#morePlatformsButton:hover {
    background-color: @alternateBaseRgba@;
    color: @windowText@;
}
QToolButton#morePlatformsButton[secondaryActive="true"] {
    background-color: @highlight@;
    color: @highlightedText@;
}
QToolButton#morePlatformsButton::menu-indicator {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 12px;
}

QHeaderView::section {
    background-color: @glassElevatedRgba@;
    color: @mutedText@;
    border: none;
    border-bottom: 1px solid @glassBorderRgba@;
    border-right: 1px solid @glassBorderRgba@;
    padding: 6px 8px;
    font-weight: 600;
}

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 0;
    border: none;
}
QScrollBar::handle:vertical {
    background: @glassBorderRgba@;
    border-radius: 5px;
    min-height: 24px;
}
QScrollBar::handle:vertical:hover {
    background: @mutedText@;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
    height: 0;
}
QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 0;
    border: none;
}
QScrollBar::handle:horizontal {
    background: @glassBorderRgba@;
    border-radius: 5px;
    min-width: 24px;
}
QScrollBar::handle:horizontal:hover {
    background: @mutedText@;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal,
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: none;
    width: 0;
}

QProgressBar {
    background-color: @glassFillRgba@;
    border: 1px solid @glassBorderRgba@;
    border-radius: 8px;
    text-align: center;
    color: @text@;
    min-height: 16px;
}
QProgressBar::chunk {
    background-color: @accent@;
    border-radius: 7px;
}

QSplitter::handle {
    background-color: @border@;
}
QSplitter::handle:horizontal {
    width: 2px;
}
QSplitter::handle:vertical {
    height: 2px;
}

QLabel#pageHeader {
    color: @windowText@;
    font-weight: 700;
    font-size: 16px;
    padding: 2px 0;
}

QPushButton#openGlobalSettingsButton {
    min-height: @controlHeight@px;
    font-weight: 600;
    text-align: left;
    padding-left: 16px;
}
QLabel#openGlobalSettingsHint {
    color: @mutedText@;
    font-size: 12px;
    padding: 0 4px 4px 4px;
}

QFrame#InfoFrame, QFrame#infoFrame {
    background-color: @glassElevatedRgba@;
    border: 1px solid @glassBorderRgba@;
    border-radius: @radius@px;
    padding: 8px;
}
QFrame#ErrorFrame, QFrame#errorFrame {
    background-color: @glassElevatedRgba@;
    border: 1px solid @danger@;
    border-radius: @radius@px;
    padding: 8px;
}

QDialogButtonBox {
    button-layout: 0;
}

/* Hack clients catalog (New Instance) */
QScrollArea#clientCatalog {
    background: transparent;
    border: none;
}
QScrollArea#clientCatalog > QWidget > QWidget {
    background: transparent;
}
QLabel#hackClientCategoryHeader {
    color: @mutedText@;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    padding: 8px 4px 2px 4px;
}
QToolButton#hackClientCard {
    background-color: @buttonRgba@;
    border: 2px solid @border@;
    border-radius: 12px;
    padding: 14px 10px 12px 10px;
    min-width: 128px;
    min-height: 122px;
    color: @windowText@;
    font-weight: 600;
    font-size: 12px;
}
QToolButton#hackClientCard:hover {
    background-color: @alternateBaseRgba@;
    border-color: @glassHighlightRgba@;
}
QToolButton#hackClientCard:checked {
    background-color: @alternateBaseRgba@;
    color: @windowText@;
    border-color: @highlight@;
}
QToolButton#hackClientCard:checked:hover {
    background-color: @alternateBaseRgba@;
    border-color: @highlight@;
}
QToolButton#hackClientCard:focus {
    outline: none;
}
QFrame#hackClientDetail {
    background-color: @glassElevatedRgba@;
    border: 1px solid @border@;
    border-radius: @radius@px;
}
QTextBrowser#hackClientDescription {
    background-color: transparent;
    border: none;
    padding: 10px;
    color: @windowText@;
}
QPushButton#refreshButton {
    padding-left: 12px;
    padding-right: 14px;
}

QListView#packView,
QListView#publicPackList,
QListView#thirdPartyPackList,
QListView#privatePackList,
QListView#modpackList {
    background-color: @glassWellRgba@;
    border: 1px solid @border@;
    border-radius: @radius@px;
    padding: 6px 4px;
    outline: 0;
}
QListView#packView::item,
QListView#publicPackList::item,
QListView#thirdPartyPackList::item,
QListView#privatePackList::item,
QListView#modpackList::item {
    padding: 0;
    margin: 3px 0;
    border: none;
    background: transparent;
}
QListView#packView::item:hover,
QListView#packView::item:selected,
QListView#publicPackList::item:hover,
QListView#publicPackList::item:selected,
QListView#thirdPartyPackList::item:hover,
QListView#thirdPartyPackList::item:selected,
QListView#privatePackList::item:hover,
QListView#privatePackList::item:selected,
QListView#modpackList::item:hover,
QListView#modpackList::item:selected {
    background: transparent;
}

/* Progress dialog — per-download resource list */
QScrollArea#taskProgressScrollArea {
    background-color: @glassFillRgba@;
    border: 1px solid @glassBorderRgba@;
    border-radius: @radius@px;
}
QScrollArea#taskProgressScrollArea > QWidget > QWidget {
    background: transparent;
}
QWidget#taskProgressContainer {
    background-color: transparent;
}
QWidget#SubTaskProgressBar {
    background-color: @glassElevatedRgba@;
    border: 1px solid @glassBorderRgba@;
    border-radius: @radius@px;
}
QWidget#SubTaskProgressBar QLabel#statusLabel {
    color: @windowText@;
    font-weight: 600;
}
QWidget#SubTaskProgressBar QLabel#statusDetailsLabel {
    color: @mutedText@;
}
QWidget#SubTaskProgressBar QProgressBar {
    min-height: 16px;
    max-height: 18px;
}
