/* Arsenal Launcher shared stylesheet — placeholders substituted by ThemeTokens::substitute */

QToolTip {
    color: @toolTipText@;
    background-color: @toolTipBase@;
    border: 1px solid @border@;
    border-radius: @radius@px;
    padding: 6px 10px;
}

QMainWindow, QDialog {
    background-color: @window@;
    color: @windowText@;
}

QMenuBar {
    background-color: @elevated@;
    color: @windowText@;
    border-bottom: 1px solid @border@;
    padding: 2px;
    spacing: 2px;
}
QMenuBar::item {
    background: transparent;
    padding: 6px 10px;
    border-radius: 4px;
}
QMenuBar::item:selected {
    background-color: @alternateBase@;
}
QMenuBar::item:pressed {
    background-color: @highlight@;
    color: @highlightedText@;
}

QMenu {
    background-color: @elevated@;
    color: @windowText@;
    border: 1px solid @border@;
    border-radius: @radius@px;
    padding: 4px;
    menu-scrollable: 1;
}
QMenu::item {
    padding: 6px 24px 6px 12px;
    border-radius: 4px;
}
QMenu::item:selected {
    background-color: @highlight@;
    color: @highlightedText@;
}
QMenu::separator {
    height: 1px;
    background: @border@;
    margin: 4px 8px;
}

QToolBar {
    background-color: @elevated@;
    border: none;
    border-bottom: 1px solid @border@;
    spacing: 6px;
    padding: 6px 10px;
}
QFrame#instanceChromeBar {
    background-color: transparent;
    border: none;
    border-bottom: 1px solid @border@;
    padding: 0 0 8px 0;
    min-height: 40px;
}
QFrame#instanceChromeSeparator {
    background: @border@;
    max-width: 1px;
    min-width: 1px;
    margin: 4px 8px;
}
QFrame#instanceChromeBar QToolButton#accountMenuButton {
    background-color: @elevated@;
    border: 1px solid @border@;
    border-radius: @radius@px;
    padding: 6px 14px 6px 8px;
    min-height: @controlHeight@px;
    font-weight: 600;
}
QFrame#instanceChromeBar QToolButton#accountMenuButton:hover {
    background-color: @alternateBase@;
    border-color: @mutedText@;
}
QFrame#instanceChromeBar QToolButton#accountMenuButton:pressed {
    background-color: @base@;
}

QFrame#instanceChromeBar QToolButton {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: @radius@px;
    padding: 6px 12px;
    min-height: @controlHeight@px;
    font-weight: 500;
}
QFrame#instanceChromeBar QToolButton:hover {
    background-color: @elevated@;
    border-color: @border@;
}
QFrame#instanceChromeBar QToolButton:pressed {
    background-color: @alternateBase@;
}
QToolButton#mainToolbarFoldersButton {
    padding: 6px 12px;
}
QToolBar::separator {
    background: @border@;
    width: 1px;
    margin: 4px 6px;
}

QFrame#instanceGridFrame {
    background-color: @base@;
    border: none;
    padding: 0;
}

QFrame#instanceActionPanel {
    background-color: @elevated@;
    border: none;
    border-left: 1px solid @border@;
    padding: 4px 0 4px 0;
    margin: 8px 8px 8px 0;
    border-top-left-radius: @radius@px;
    border-bottom-left-radius: @radius@px;
}

QLabel#instancePanelSubtitle {
    color: @mutedText@;
    font-size: 11px;
}

QPushButton#instancePanelName {
    color: @windowText@;
    font-size: 15px;
    font-weight: 600;
    text-align: left;
    padding: 4px 6px;
}

QToolButton#launchPrimaryButton {
    background-color: @accent@;
    color: @accentText@;
    border: 1px solid @accent@;
    border-radius: @radius@px;
    padding: 12px 16px;
    font-weight: 600;
    font-size: 13px;
    min-height: 44px;
}
QToolButton#launchPrimaryButton:hover {
    background-color: @highlight@;
    border-color: @highlight@;
    color: @accentText@;
}
QToolButton#launchPrimaryButton:disabled {
    background-color: @alternateBase@;
    color: @mutedText@;
    border-color: @border@;
}
QToolButton#launchPrimaryButton::menu-button {
    background-color: @accent@;
    border: 1px solid @accent@;
    border-top-right-radius: @radius@px;
    border-bottom-right-radius: @radius@px;
    border-left: 1px solid @accentText@;
    padding: 12px 8px;
    width: 28px;
}
QToolButton#launchPrimaryButton::menu-button:hover {
    background-color: @highlight@;
    border-color: @highlight@;
}
QToolButton#launchPrimaryButton::menu-button:disabled {
    background-color: @alternateBase@;
    border-color: @border@;
    border-left-color: @border@;
}
QToolButton#launchPrimaryButton::menu-indicator {
    image: none;
    width: 0;
    height: 0;
}

QPushButton#instancePanelKillButton {
    color: @danger@;
    border: 1px solid transparent;
    border-radius: @radius@px;
    padding: 10px 14px;
    min-height: 44px;
}
QPushButton#instancePanelKillButton:hover {
    background-color: @alternateBase@;
    border-color: @border@;
}
QPushButton#instancePanelKillButton:disabled {
    color: @mutedText@;
}

QFrame#instanceAccountPicker {
    background-color: @base@;
    border: 1px solid @border@;
    border-radius: @radius@px;
}
QFrame#instanceAccountPicker:hover {
    background-color: @alternateBase@;
    border-color: @accent@;
}
QFrame#instanceAccountPicker[launchBlocked="true"] {
    border-color: @danger@;
    background-color: @elevated@;
}
QFrame#instanceAccountPicker:disabled {
    color: @mutedText@;
    background-color: @window@;
}

QLabel#instanceAccountFace {
    background-color: transparent;
}

QLabel#instanceAccountTitle {
    font-weight: 600;
    color: @windowText@;
}

QLabel#instanceAccountMeta {
    color: @mutedText@;
    font-size: 11px;
}
QLabel#instanceAccountMeta[launchBlocked="true"] {
    color: @danger@;
    font-weight: 600;
}

QToolButton#instanceAccountMenuButton {
    border: none;
    padding: 4px;
    background: transparent;
}
QToolButton#instanceAccountMenuButton:hover {
    background-color: @elevated@;
    border-radius: 4px;
}
QToolButton#instanceAccountMenuButton:disabled {
    color: @mutedText@;
}

QLabel#instanceAccountHeading {
    color: @mutedText@;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    padding: 0 2px;
}

QLabel#instanceAccountCaption {
    color: @mutedText@;
    font-size: 11px;
    padding: 0 4px 4px 4px;
}
QLabel#instanceAccountCaption[launchBlocked="true"] {
    color: @danger@;
}

QPushButton#instancePanelLinkButton {
    text-align: left;
    padding: 10px 12px;
    border: 1px solid transparent;
    border-radius: @radius@px;
    color: @windowText@;
}
QPushButton#instancePanelLinkButton:hover {
    background-color: @alternateBase@;
    border-color: @border@;
}
QPushButton#instancePanelLinkButton:disabled {
    color: @mutedText@;
}

QScrollArea#instancePanelActionsScroll {
    background: transparent;
    border: none;
}
QWidget#instancePanelActions {
    background: transparent;
}

QToolButton#accountMenuButton {
    background-color: @elevated@;
    border: 1px solid @border@;
    border-radius: @radius@px;
    padding: 6px 14px 6px 8px;
    min-height: @controlHeight@px;
    font-weight: 600;
}
QToolButton#accountMenuButton:hover {
    background-color: @alternateBase@;
    border-color: @mutedText@;
}
QToolButton#accountMenuButton:pressed {
    background-color: @base@;
}
QToolButton#accountMenuButton::menu-indicator {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 12px;
    height: 12px;
    right: 8px;
}

/* Instance toolbar account picker */
QToolButton#instancePanelIconButton {
    padding: 6px;
    border-radius: @radius@px;
    background-color: @base@;
    border: 1px solid @border@;
}
QToolButton#instancePanelIconButton:hover {
    border-color: @accent@;
    background-color: @alternateBase@;
}
QToolButton {
    background-color: transparent;
    color: @windowText@;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 6px 10px;
    margin: 1px;
}
QToolButton:hover {
    background-color: @alternateBase@;
    border-color: @border@;
}
QToolButton:pressed, QToolButton:checked {
    background-color: @highlight@;
    color: @highlightedText@;
    border-color: @highlight@;
}

QStatusBar {
    background-color: @elevated@;
    color: @mutedText@;
    border-top: 1px solid @border@;
}
QStatusBar::item {
    border: none;
}

QPushButton {
    background-color: @button@;
    color: @buttonText@;
    border: 1px solid @border@;
    border-radius: @radius@px;
    padding: 6px 14px;
    min-height: 22px;
}
QPushButton:hover {
    background-color: @alternateBase@;
    border-color: @mutedText@;
}
QPushButton:pressed {
    background-color: @highlight@;
    color: @highlightedText@;
    border-color: @highlight@;
}
QPushButton:disabled {
    color: @mutedText@;
    background-color: @window@;
}
QPushButton:default, QPushButton[primary="true"] {
    background-color: @accent@;
    color: @accentText@;
    border-color: @accent@;
    font-weight: 600;
}
QPushButton:default:hover, QPushButton[primary="true"]:hover {
    background-color: @highlight@;
}
QPushButton#searchButton[filterActive="true"] {
    text-decoration: underline;
    color: @accent@;
    font-weight: 600;
}

QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QDoubleSpinBox, QComboBox {
    background-color: @base@;
    color: @text@;
    border: 1px solid @border@;
    border-radius: @radius@px;
    padding: 5px 8px;
    selection-background-color: @highlight@;
    selection-color: @highlightedText@;
}
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus,
QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus {
    border-color: @accent@;
}
QLineEdit:disabled, QComboBox:disabled, QSpinBox:disabled {
    color: @mutedText@;
    background-color: @window@;
}

QComboBox::drop-down {
    border: none;
    width: 24px;
}
QComboBox QAbstractItemView {
    background-color: @elevated@;
    color: @text@;
    border: 1px solid @border@;
    selection-background-color: @highlight@;
    selection-color: @highlightedText@;
    outline: 0;
}

QCheckBox, QRadioButton {
    spacing: 8px;
    color: @windowText@;
}
QCheckBox::indicator, QRadioButton::indicator {
    width: 16px;
    height: 16px;
}

QGroupBox {
    background-color: @elevated@;
    border: 1px solid @border@;
    border-radius: @radius@px;
    margin-top: 12px;
    padding: 12px 10px 10px 10px;
    font-weight: 600;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 6px;
    color: @windowText@;
}

QTabWidget::pane {
    border: 1px solid @border@;
    border-radius: @radius@px;
    background-color: @elevated@;
    top: -1px;
}
QTabBar::tab {
    background-color: @window@;
    color: @mutedText@;
    border: 1px solid @border@;
    border-bottom: none;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    padding: 8px 14px;
    margin-right: 2px;
}
QTabBar::tab:selected {
    background-color: @elevated@;
    color: @windowText@;
    font-weight: 600;
}
QTabBar::tab:hover:!selected {
    color: @windowText@;
    background-color: @alternateBase@;
}

QListView, QTreeView, QTableView {
    background-color: @base@;
    alternate-background-color: @alternateBase@;
    color: @text@;
    border: 1px solid @border@;
    border-radius: @radius@px;
    outline: 0;
    selection-background-color: @highlight@;
    selection-color: @highlightedText@;
}
QListView::item, QTreeView::item {
    padding: 4px;
    border-radius: 4px;
}
QListView::item:hover, QTreeView::item:hover {
    background-color: @alternateBase@;
}
QListView::item:selected, QTreeView::item:selected {
    background-color: @highlight@;
    color: @highlightedText@;
}

/* Settings / instance page sidebar */
QListView#pageList,
QTreeView#pageList {
    background-color: @elevated@;
    border: none;
    border-right: 1px solid @border@;
    border-radius: 0;
    padding: 8px 6px;
    outline: 0;
}
QListView#pageList::item,
QTreeView#pageList::item {
    padding: 8px 12px;
    margin: 2px 4px;
    border-radius: 6px;
    min-height: 24px;
}
QListView#pageList::item:selected,
QTreeView#pageList::item:selected {
    background-color: @highlight@;
    color: @highlightedText@;
}
QListView#pageList::item:hover:!selected,
QTreeView#pageList::item:hover:!selected {
    background-color: @alternateBase@;
}
QTreeView#pageList::branch {
    background: transparent;
}
QTreeView#pageList::branch:has-children:closed,
QTreeView#pageList::branch:has-children:open {
    border-image: none;
    image: none;
}

QToolButton#morePlatformsButton {
    background-color: transparent;
    color: @mutedText@;
    border: none;
    border-radius: 6px;
    padding: 8px 12px;
    margin: 2px 4px 8px 4px;
    min-height: 32px;
    text-align: left;
}
QToolButton#morePlatformsButton:hover {
    background-color: @alternateBase@;
    color: @windowText@;
}
QToolButton#morePlatformsButton[secondaryActive="true"] {
    background-color: @highlight@;
    color: @highlightedText@;
}
QToolButton#morePlatformsButton::menu-indicator {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 12px;
}

QHeaderView::section {
    background-color: @elevated@;
    color: @mutedText@;
    border: none;
    border-bottom: 1px solid @border@;
    border-right: 1px solid @border@;
    padding: 6px 8px;
    font-weight: 600;
}

QScrollBar:vertical {
    background: @window@;
    width: 10px;
    margin: 0;
    border: none;
}
QScrollBar::handle:vertical {
    background: @border@;
    border-radius: 5px;
    min-height: 24px;
}
QScrollBar::handle:vertical:hover {
    background: @mutedText@;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
    height: 0;
}
QScrollBar:horizontal {
    background: @window@;
    height: 10px;
    margin: 0;
    border: none;
}
QScrollBar::handle:horizontal {
    background: @border@;
    border-radius: 5px;
    min-width: 24px;
}
QScrollBar::handle:horizontal:hover {
    background: @mutedText@;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal,
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: none;
    width: 0;
}

QProgressBar {
    background-color: @base@;
    border: 1px solid @border@;
    border-radius: 6px;
    text-align: center;
    color: @text@;
    min-height: 16px;
}
QProgressBar::chunk {
    background-color: @accent@;
    border-radius: 5px;
}

QSplitter::handle {
    background-color: @border@;
}
QSplitter::handle:horizontal {
    width: 1px;
}
QSplitter::handle:vertical {
    height: 1px;
}

QLabel#pageHeader {
    color: @windowText@;
    font-weight: 700;
    padding: 4px 0;
}

QFrame#InfoFrame, QFrame#infoFrame {
    background-color: @alternateBase@;
    border: 1px solid @border@;
    border-radius: @radius@px;
    padding: 8px;
}
QFrame#ErrorFrame, QFrame#errorFrame {
    background-color: @alternateBase@;
    border: 1px solid @danger@;
    border-radius: @radius@px;
    padding: 8px;
}

QDialogButtonBox {
    button-layout: 0;
}

/* Hack clients (New Instance) */
QListWidget#clientList {
    background-color: @elevated@;
    border: 1px solid @border@;
    border-radius: @radius@px;
    padding: 6px;
    outline: none;
}
QListWidget#clientList::item {
    border-radius: 6px;
    padding: 8px 10px;
    margin: 2px 0;
}
QListWidget#clientList::item:selected {
    background-color: @highlight@;
    color: @highlightedText@;
}
QListWidget#clientList::item:hover:!selected {
    background-color: @alternateBase@;
}
QTextBrowser#hackClientDescription {
    background-color: @elevated@;
    border: 1px solid @border@;
    border-radius: @radius@px;
    padding: 10px;
    color: @windowText@;
}
QPushButton#refreshButton {
    padding-left: 12px;
    padding-right: 14px;
}
